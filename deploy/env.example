# Keep the real file outside the repository.
# Use a container-readable copy of the Codex login, for example:
# sudo install -o 10001 -g 65534 -m 0400 ~/.codex/auth.json /opt/codex-voice/auth.json
CODEX_VOICE_AUTH_FILE=/opt/codex-voice/auth.json
CODEX_VOICE_API_KEY=replace-with-a-long-random-api-key
CODEX_VOICE_PORT=2600
CODEX_VOICE_CONCURRENCY=1
CODEX_VOICE_MAX_UPLOAD_MB=10
CODEX_VOICE_REQUEST_TIMEOUT_SECONDS=120
CODEX_VOICE_CONNECT_TIMEOUT_SECONDS=10
# CODEX_VOICE_PROXY=http://host.docker.internal:7890
